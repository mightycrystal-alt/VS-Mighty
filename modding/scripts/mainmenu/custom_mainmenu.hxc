var addedBackground:Bool = false;
var styledMenu:Bool = false;

function create() {
    MainMenuState.rankedVer = '0.1';
    MainMenuState.engineName = 'VS Mighty';
}

function onUpdate(elapsed:Float)
{
    if (!styledMenu && state.menuItems.members.length > 0) {
        var offset:Float = 108 - (Math.max(state.menuItems.members.length, 4) - 4) * 80;
        state.menuItems.forEach(function(menuItem:FlxSprite) {
            menuItem.y = (menuItem.ID * 140) + offset;
            menuItem.antialiasing = false;
            menuItem.scrollFactor.set();
            menuItem.scale.set(2.5, 2.5);
            menuItem.x = 20;
            menuItem.updateHitbox();
        });
        MainMenuState.menuItemScreenCenter = false;
        styledMenu = true;
    }

    if (addedBackground) return;

    var background:FlxSprite = new FlxSprite(-80);
    background.loadGraphic(Paths.image('menuMighty'));
    background.scrollFactor.set(0, 0.25);
    background.setGraphicSize(Std.int(background.width * 1.175));
    background.updateHitbox();
    background.screenCenter();
    background.antialiasing = false;

    state.insert(3, background);
    addedBackground = true;
}